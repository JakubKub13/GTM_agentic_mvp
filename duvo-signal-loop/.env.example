# ============================================================================
#  duvo-signal-loop — environment variables
#  Copy this file to ".env" and fill in the values:   cp .env.example .env
#  .env is gitignored — never commit real keys.
#  Every "where to get it" below is verified against the providers' own docs
#  (source URLs included). Nothing here is guessed.
# ============================================================================


# ----------------------------------------------------------------------------
#  EXA — web search API used by the scout + analyst agents
#  REQUIRED to run anything (including --dry-run).
#
#  Where to get it:
#    1. Sign up / log in at https://dashboard.exa.ai/
#    2. Open the "API Keys" page: https://dashboard.exa.ai/api-keys
#    3. Create a new key and copy it — it is shown only once.
#  Cost: new accounts get $10 in free credits, enough for this build/demo.
#  Docs: https://exa.ai/docs/reference/getting-started
#        https://dashboard.exa.ai/api-keys
# ----------------------------------------------------------------------------
EXA_API_KEY=


# ----------------------------------------------------------------------------
#  ANTHROPIC (Claude) — the LLM every agent runs on
#  REQUIRED to run anything (including --dry-run).
#
#  Where to get it:
#    1. Create / log in to a Claude Console account at https://platform.claude.com/
#    2. Go to Account Settings → API keys: https://platform.claude.com/settings/keys
#    3. Generate a key and copy it. Keys start with "sk-ant-".
#  Note: this is a PAID developer API key (separate from any Claude.ai chat
#        subscription) — it is billed per token.
#  Docs: https://platform.claude.com/docs/en/api/getting-started
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------------
#  HUBSPOT — the CRM the router agent writes accounts + evidence notes into
#  Required only for real write-back (not needed for --dry-run).
#
#  Where to get a Private App access token:
#    1. In your HubSpot account: Settings → Integrations → Private Apps.
#       (If "Private Apps" is missing, your portal type doesn't support it —
#        see the Service Key alternative below.)
#    2. Create a private app. On the "Scopes" tab, add new scopes and enable:
#         - crm.objects.companies.read
#         - crm.objects.companies.write
#         - crm.objects.contacts.read
#         - crm.objects.contacts.write
#         - crm.objects.notes.write        (write notes)
#         - crm.schemas.companies.read
#         - crm.schemas.companies.write    (needed to create the icp_score property)
#    3. Create the app, then copy the token from its "Auth" tab.
#  Alternative (newer HubSpot accounts): a Service Key under
#       Development → Keys → Service Keys. Use it the same way as the token.
#  Docs: https://developers.hubspot.com/docs/apps/legacy-apps/private-apps/overview
#        https://sfailabs.com/guides/how-to-get-hubspot-api-key
# ----------------------------------------------------------------------------
HUBSPOT_TOKEN=


# ----------------------------------------------------------------------------
#  SLACK — incoming webhook the router uses to alert #sales on Tier-1 accounts
#  Required only for real Slack alerts (not needed for --dry-run).
#
#  Where to get an Incoming Webhook URL:
#    1. Create a Slack app: https://api.slack.com/apps?new_app=1
#       (pick a name + your workspace)
#    2. In the app settings, toggle "Activate Incoming Webhooks" ON.
#    3. Click "Add New Webhook to Workspace", choose the target channel
#       (e.g. #sales), and authorize.
#    4. Copy the URL under "Webhook URLs for Your Workspace". It looks like:
#         https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXX
#  Keep it secret — Slack revokes leaked webhook URLs.
#  Docs: https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks
# ----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=


# ----------------------------------------------------------------------------
#  LEMLIST — the router queues confident Tier-1 leads here as PAUSED drafts
#  Required only for the lemlist step (not needed for --dry-run).
#
#  Where to get the API key:
#    1. In lemlist, click your profile icon (bottom-left) → Settings.
#    2. Go to "Integrations" and click "Generate" to create your API key.
#       (If you can't, your account type may not include API access — a paid
#        plan is generally required.)
#  Docs: https://help.lemlist.com/en/articles/4452694-find-and-use-the-lemlist-api
# ----------------------------------------------------------------------------
LEMLIST_API_KEY=

#  The campaign the leads are added to. IT MUST BE LEFT PAUSED so leads land
#  as drafts and are never auto-sent — this is the human-in-the-loop gate.
#  Where to find the campaign ID:
#    - Create a campaign in lemlist and leave it paused; the ID is in the
#      campaign page URL, OR
#    - List campaigns via the API (basic auth, username empty, password = key):
#        curl -u ":YOUR_LEMLIST_API_KEY" https://api.lemlist.com/api/campaigns
#  Docs: https://developer.lemlist.com/api-reference/endpoints/leads/create-lead-in-campaign
# ----------------------------------------------------------------------------
LEMLIST_CAMPAIGN_ID=


# ----------------------------------------------------------------------------
#  TEST_EMAIL — used as the lead email when queuing into lemlist during the
#  demo (we don't have real prospects' emails). Use your own address so you
#  can see the queued draft. No external account needed.
# ----------------------------------------------------------------------------
TEST_EMAIL=jakubkubala3@gmail.com
