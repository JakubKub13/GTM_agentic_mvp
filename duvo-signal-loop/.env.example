# ============================================================================
#  duvo-signal-loop — environment variables
#  Copy this file to ".env" and fill in the values:   cp .env.example .env
#  .env is gitignored — never commit real keys.
#  Every "where to get it" below is verified against the providers' own docs
#  (source URLs included). Nothing here is guessed.
# ============================================================================


# ----------------------------------------------------------------------------
#  EXA — web search API used by the scout + analyst agents
#  REQUIRED to run anything (including --dry-run).
#
#  Where to get it:
#    1. Sign up / log in at https://dashboard.exa.ai/
#    2. Open the "API Keys" page: https://dashboard.exa.ai/api-keys
#    3. Create a new key and copy it — it is shown only once.
#  Cost: new accounts get $10 in free credits, enough for this build/demo.
#  Docs: https://exa.ai/docs/reference/getting-started
# ----------------------------------------------------------------------------
EXA_API_KEY=


# ----------------------------------------------------------------------------
#  ANTHROPIC (Claude) — the LLM every agent runs on
#  REQUIRED to run anything (including --dry-run).
#
#  Where to get it:
#    1. Create / log in to a Claude Console account at https://platform.claude.com/
#    2. Account Settings → API keys: https://platform.claude.com/settings/keys
#    3. Generate a key and copy it. Keys start with "sk-ant-".
#  Note: paid developer API key (separate from any Claude.ai chat plan), billed per token.
#  Docs: https://platform.claude.com/docs/en/api/getting-started
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=


# ----------------------------------------------------------------------------
#  CRM provider — which CRM the router agent writes into.
#  "attio"   -> uses ATTIO_API_KEY  (default; instant signup, free API)
#  "hubspot" -> uses HUBSPOT_TOKEN  (Duvo's real stack; drop-in once you have a portal)
#  The router calls one interface (crm.upsert_account); only this flag changes the target.
# ----------------------------------------------------------------------------
CRM_PROVIDER=attio


# ----------------------------------------------------------------------------
#  ATTIO — the CRM the router agent writes accounts + evidence notes into (default)
#  Required only for real write-back (not needed for --dry-run).
#
#  Why Attio: a real modern CRM (sales teams use it), free plan INCLUDES API access,
#  and you can self-serve an API token immediately — no business email, no wait.
#
#  Where to get the API key:
#    1. Sign up / log in at https://app.attio.com (Google or email — frictionless).
#    2. Workspace Settings → Developers → "Create a new integration".
#    3. Name it (e.g. "duvo-signal-loop"), then generate an access token (Bearer).
#       You must be a workspace admin — you are, it's your own workspace.
#  API base: https://api.attio.com/v2   (Authorization: Bearer <token>)
#  Docs: https://attio.com/help/apps/other-apps/generating-an-api-key
#        https://docs.attio.com/rest-api/endpoint-reference/records/create-a-record
# ----------------------------------------------------------------------------
ATTIO_API_KEY=


# ----------------------------------------------------------------------------
#  HUBSPOT — optional alternative CRM (Duvo's real stack). Only used if
#  CRM_PROVIDER=hubspot. Leave blank when using Attio.
#
#  Where to get a Private App token (needs a CRM portal, NOT a developer portal):
#    1. In a HubSpot CRM account: Settings → Integrations → Private Apps.
#    2. Scopes tab → enable: crm.objects.companies.read/write,
#       crm.objects.contacts.read/write, crm.objects.notes.write,
#       crm.schemas.companies.read/write.
#    3. Create the app, copy the token from its "Auth" tab.
#  Note: a HubSpot *developer* account does NOT support Private Apps — create a
#        "developer test account" (Development → Testing → Test Accounts) which is
#        a real CRM portal, and make the private app there.
#  Docs: https://developers.hubspot.com/docs/apps/legacy-apps/private-apps/overview
# ----------------------------------------------------------------------------
HUBSPOT_TOKEN=


# ----------------------------------------------------------------------------
#  SLACK — incoming webhook the router uses to alert #sales on Tier-1 accounts
#  Required only for real Slack alerts (not needed for --dry-run).
#
#  Where to get an Incoming Webhook URL:
#    1. Create a Slack app: https://api.slack.com/apps?new_app=1
#    2. Toggle "Activate Incoming Webhooks" ON.
#    3. "Add New Webhook to Workspace", choose the channel (e.g. #sales), authorize.
#    4. Copy the URL: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX
#  Keep it secret — Slack revokes leaked webhook URLs.
#  Docs: https://docs.slack.dev/messaging/sending-messages-using-incoming-webhooks
# ----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=


# ----------------------------------------------------------------------------
#  LEMLIST — the router queues confident Tier-1 leads here as PAUSED drafts
#  Required only for the lemlist step (not needed for --dry-run).
#
#  API key:    lemlist → profile icon (bottom-left) → Settings → Integrations → Generate.
#  Docs:       https://help.lemlist.com/en/articles/4452694-find-and-use-the-lemlist-api
# ----------------------------------------------------------------------------
LEMLIST_API_KEY=

#  Campaign the leads are added to. MUST BE LEFT PAUSED so leads land as drafts
#  and are never auto-sent — this is the human-in-the-loop gate.
#  Find the campaign ID: from the campaign page URL, OR list via the API
#    curl -u ":YOUR_LEMLIST_API_KEY" https://api.lemlist.com/api/campaigns
#  Docs: https://developer.lemlist.com/api-reference/endpoints/leads/create-lead-in-campaign
# ----------------------------------------------------------------------------
LEMLIST_CAMPAIGN_ID=


# ----------------------------------------------------------------------------
#  TEST_EMAIL — used as the lead email when queuing into lemlist during the demo
#  (we don't have real prospects' emails). Use your own address. No account needed.
# ----------------------------------------------------------------------------
TEST_EMAIL=jakubkubala3@gmail.com
